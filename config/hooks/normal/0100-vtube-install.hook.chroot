#!/bin/sh
set -eu
install -d -m 0755 /opt/vtube-os
cp -a /run/live/medium/vtube-os-source/. /opt/vtube-os/ 2>/dev/null || true
# The build script stages the source into config/includes.chroot/opt/vtube-os,
# so this fallback keeps the hook harmless if run from a different build layout.
if [ -f /opt/vtube-os/app.py ]; then
  chmod 0755 /opt/vtube-os/app.py /opt/vtube-os/run.sh 2>/dev/null || true
fi
install -d -m 0755 /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/vtube-control-center.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=VTUBE OS Control Center
Comment=VTUBE-first live streaming workspace
Exec=python3 /opt/vtube-os/app.py
Terminal=false
X-GNOME-Autostart-enabled=true
EOF
